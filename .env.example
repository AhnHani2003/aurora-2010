# Public release: no database, email keys or production secrets required.
# Standalone is the default in development AND production. Rebuild after changing.
NEXT_PUBLIC_RELEASE_MODE=standalone
# The playful client-side entry code is aurora; it is not secure authentication.
# Everything below is unused in standalone mode. Preserve for a future backend release.
AURORA_ACCESS_PASSWORD=
# Generate a random secret with at least 32 characters; changing it invalidates sessions.
SESSION_SECRET=
# Supabase > Connect > Transaction pooler connection string. URL-encode password special characters.
SUPABASE_DATABASE_URL=

RESEND_API_KEY=
RESULT_EMAIL_TO=manhthong2003@gmail.com
# A sender on your verified Resend domain, e.g. Tom <surprise@example.com>
RESULT_EMAIL_FROM=
# Separate random token used only for an external scheduler calling /api/email/retry.
EMAIL_RETRY_SECRET=
